{
  "name": "@kobito/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed:dev-auth": "tsx scripts/seed-dev-auth.ts",
    "seed:dev-admin": "tsx scripts/seed-dev-admin.ts",
    "admin:dev-code": "tsx scripts/dev-admin-code.ts",
    "smoke:local-auth": "tsx scripts/smoke-local-auth.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@kobito/shared": "workspace:*",
    "dotenv": "16.6.1",
    "firebase-admin": "14.5.0",
    "hono": "4.13.14",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "tsx": "4.20.6"
  }
}
