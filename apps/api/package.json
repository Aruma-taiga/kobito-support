{
  "name": "@kobito/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "job:daily": "tsx src/jobs/daily-billing-script.ts",
    "job:notifications": "tsx src/jobs/notifications-script.ts",
    "job:retention": "tsx src/jobs/retention-script.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed:dev-auth": "tsx scripts/seed-dev-auth.ts",
    "seed:dev-billing": "tsx scripts/seed-dev-billing.ts",
    "seed:dev-admin": "tsx scripts/seed-dev-admin.ts",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "admin:dev-code": "tsx scripts/dev-admin-code.ts",
    "smoke:local-auth": "tsx scripts/smoke-local-auth.ts",
    "smoke:line-auth": "tsx scripts/smoke-line-auth.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@kobito/shared": "workspace:*",
    "dotenv": "16.6.1",
    "firebase-admin": "14.5.0",
    "hono": "4.13.14",
    "pg": "8.16.3",
    "playwright-core": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "firebase": "13.1.0",
    "tsx": "4.20.6"
  }
}
