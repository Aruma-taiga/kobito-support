{
  "name": "kobito-support",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "vitest run",
    "test:db": "pnpm --filter @kobito/db test:db",
    "build:shared": "pnpm --filter @kobito/shared build",
    "build:api": "pnpm --filter @kobito/api build",
    "build:web": "pnpm build:shared && pnpm --filter @kobito/web build",
    "build": "pnpm build:shared && pnpm build:api && pnpm --filter @kobito/web build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @kobito/api --filter @kobito/web dev",
    "dev:api": "pnpm --filter @kobito/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @kobito/web dev",
    "dev:seed-auth": "pnpm --filter @kobito/api seed:dev-auth",
    "dev:smoke-auth": "pnpm --filter @kobito/api smoke:local-auth",
    "db:migrate": "pnpm --filter @kobito/db migrate",
    "db:seed": "pnpm --filter @kobito/db seed",
    "db:reset": "pnpm --filter @kobito/db reset",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "22.19.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
