# 実在のプロジェクト、ドメイン、アカウント情報や秘密値を記入しないこと。
gcp_project_id                        = "YOUR_GCP_PROJECT_ID"
region                                = "asia-northeast1"
name_prefix                           = "kobito-support"
cloudflare_api_token                  = ""
cloudflare_zone_id                    = "YOUR_CLOUDFLARE_ZONE_ID"
cloudflare_account_id                 = "YOUR_CLOUDFLARE_ACCOUNT_ID"
domain_name                           = "example.invalid"
api_image                             = "asia-northeast1-docker.pkg.dev/PROJECT/REPOSITORY/API_IMAGE:TAG"
database_password_secret_version      = "1"
scheduler_paused                      = true
web_firebase_api_key                   = ""
web_firebase_auth_domain               = "PROJECT_ID.firebaseapp.com"
web_firebase_project_id                = "YOUR_GCP_PROJECT_ID"
web_firebase_app_id                    = ""
resend_spf_value                       = "v=spf1 include:RESEND_PROVIDER ~all"
resend_dkim_name                       = "RESEND_DKIM_HOST"
resend_dkim_value                      = "RESEND_DKIM_VALUE"
mail_from_domain                       = "example.invalid"
service_name                           = ""
company_name                           = ""
invoice_prefix                         = "KS"
terraform_state_bucket                 = "YOUR_TERRAFORM_STATE_BUCKET"
